    "next": "^16.3.4",
    "next-sanity": "^13.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.13.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
