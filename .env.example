NEXT_PUBLIC_SANITY_PROJECT_ID="u8ld2tbd"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-01"
NEXT_PUBLIC_SANITY_STUDIO_URL="/studio"
# Public URL of the site, used for the sitemap and social cards
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Viewer-role token (sanity.io/manage → API → Tokens): Draft Mode, Presentation, live preview
SANITY_API_READ_TOKEN=""
# Shared secret for the listing revalidation webhook (see docs/CMS.md).
# Generate one with: openssl rand -base64 32
# Server-only — it is never sent to the browser.
SANITY_REVALIDATE_SECRET=""

# ---- Display currency (optional) --------------------------------
# Prices are stored in USD; the header picker only changes what
# visitors are shown. Rates come from free, keyless providers by
# default (open.er-api.com, then a CDN snapshot, then Frankfurter),
# so nothing below is required.
# Set these only to put a commercial feed in front of them. The key
# is used server-side and never reaches the browser.
FX_API_URL=""
FX_API_KEY=""
